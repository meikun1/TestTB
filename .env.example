# Telegram API (https://my.telegram.org/apps)
TG_API_ID=
TG_API_HASH=
TG_PHONE=+998XXXXXXXXX
TG_SESSION_NAME=tg_assistant_session

# LLM
ANTHROPIC_API_KEY=
USE_LOCAL_MODEL=false
LOCAL_MODEL_URL=http://localhost:8000/v1

# === Лимиты отправки ===
MAX_MESSAGES_PER_DAY=20
MAX_MESSAGES_PER_HOUR=4
WEEKEND_MULTIPLIER=0.5

# === Паузы (секунды) ===
MIN_DELAY_SECONDS=420
MAX_DELAY_SECONDS=3600

# === Окна активности ===
WORKING_HOURS_START=10
WORKING_HOURS_END=22
MANDATORY_SLEEP_START=0
MANDATORY_SLEEP_END=8

# === Имитация поведения ===
SIMULATE_TYPING=true
TYPING_SECONDS_PER_CHAR=0.08
TYPING_MAX_SECONDS=45
READ_INCOMING_BEFORE_SEND=true
SKIP_PROBABILITY=0.15

# === Антиспам-фильтры ===
MIN_INCOMING_MESSAGES=3
MIN_DAYS_BETWEEN_SENDS=30
REPLY_RATE_WINDOW=15
REPLY_RATE_MIN=0.25
REPLY_RATE_CHECK_HOURS=48

# === Ramp-up ===
RAMPUP_ENABLED=true
RAMPUP_DAYS=14
RAMPUP_START_LIMIT=3

# Хранилище
DB_PATH=data/tg_assistant.db
