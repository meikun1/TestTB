# === Telegram API (один app на my.telegram.org, общий для всех аккаунтов) ===
TG_API_ID=
TG_API_HASH=

# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tg_broadcaster

# PgBouncer — нужен от ~1000 аккаунтов (см. docs/SCALE_10K.md)
# Перегенерируй compose: python scripts/gen_compose.py --shards 100 --pgbouncer
USE_PGBOUNCER=false
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# === Sender ===
# WORKER_COUNT = сколько шард всего у системы. На 50 акк ставь 10, на 10к — 100.
WORKER_COUNT=10
# Сколько коннектов один воркер держит одновременно (memory = N × 40MB)
SENDER_PARALLEL_ACCOUNTS=20
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=90
ATTACHMENT_DELAY_MIN=5
ATTACHMENT_DELAY_MAX=30

# === Optout polling ===
OPTOUT_POLL_INTERVAL_SECONDS=600
OPTOUT_MESSAGES_PER_POLL=20

# === Геоконсистентность для UZ ===
ACTIVE_TIMEZONE=Asia/Tashkent
ACTIVE_HOURS_START=9
ACTIVE_HOURS_END=23

# === Device-fingerprint strictness (КРИТИЧНО!) ===
# Вся идея проекта — каждый аккаунт ходит со СВОИМ реальным device-fingerprint
# (тот с которого он изначально логинился). Дефолты Telethon "Desktop"/"en" для
# UZ-номера выглядят для антифрода как угнанная сессия.
#
# true (рекомендуется): импорт жёстко требует все 5 device-полей в CSV.
#                       Аккаунты без них отвергаются.
# false (НЕ рекомендуется): пустые поля молча заменяются на FALLBACK_*.
STRICT_REAL_FINGERPRINT=true
# Используется только если STRICT_REAL_FINGERPRINT=false
FALLBACK_LANG_CODE=ru
FALLBACK_SYSTEM_LANG_CODE=ru-UZ

RESPECT_CARRIER_LIMITS=true
BEELINE_UZ_LIMIT_MULTIPLIER=0.6
CARRIER_HOURLY_CAP=50
EXPECTED_COUNTRY_CODE=998
EXPECTED_NEAREST_DC_COUNTRY=UZ

# === Email-верификация (catch-all почтовый сервер) ===
EMAIL_DOMAIN=veximail.space
IMAP_HOST=mail.veximail.space
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USER=catchall@veximail.space
IMAP_PASSWORD=
EMAIL_CODE_TIMEOUT_SECONDS=180

# === Captcha (детали логики уточняются) ===
CAPTCHA_SOLVER=manual
CAPTCHA_TIMEOUT_SECONDS=300

# === Intake API (приём аккаунтов потоком из warmup-пайплайна) ===
INTAKE_HOST=0.0.0.0
INTAKE_PORT=8090
INTAKE_TOKEN=change-me-to-long-random
INTAKE_SYNC_TIMEOUT_SECONDS=180

# === Опциональные алерты в Telegram-бот ===
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
