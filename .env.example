# === Telegram API (один app на my.telegram.org, общий для всех аккаунтов) ===
TG_API_ID=
TG_API_HASH=

# Прокси: false — все ходят напрямую (только для теста!), true — берут account.proxy
PROXIES_ENABLED=false

# === LLM ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
USE_LOCAL_MODEL=false
LOCAL_MODEL_URL=http://localhost:8000/v1

# === PostgreSQL ===
USE_POSTGRES=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tg
POSTGRES_PASSWORD=tg
POSTGRES_DB=tg_assistant
# SQLite fallback (если USE_POSTGRES=false)
DB_PATH=data/tg_assistant.db

# === Redis ===
REDIS_URL=redis://redis:6379/0
REDIS_CHANNEL_POOL=tg_assistant.pool.reload

# === Sender-воркеры ===
# Должно совпадать с количеством sender-N в docker-compose.yml
WORKER_COUNT=10

# === Фоновый fetcher ===
FETCHER_INTERVAL_HOURS=24
FETCHER_MESSAGES_PER_DIALOG=200

# === Дефолтные лимиты для новых аккаунтов ===
DEFAULT_DAILY_LIMIT=50
DEFAULT_HOURLY_LIMIT=8
WEEKEND_MULTIPLIER=0.5

# === Паузы между отправками ===
MIN_DELAY_SECONDS=420
MAX_DELAY_SECONDS=3600

# === Окно активности ===
WORKING_HOURS_START=10
WORKING_HOURS_END=22
MANDATORY_SLEEP_START=0
MANDATORY_SLEEP_END=8

# === Имитация поведения ===
SIMULATE_TYPING=true
TYPING_SECONDS_PER_CHAR=0.08
TYPING_MAX_SECONDS=45
READ_INCOMING_BEFORE_SEND=true
SKIP_PROBABILITY=0.15

# === Вложения ===
# Пауза между текстом и вложением, если attachment_delay_seconds==0 на драфте
ATTACHMENT_DEFAULT_DELAY_MIN=5
ATTACHMENT_DEFAULT_DELAY_MAX=30

# === Антиспам-фильтры ===
MIN_INCOMING_MESSAGES=3
MIN_DAYS_BETWEEN_SENDS=30
REPLY_RATE_WINDOW=15
REPLY_RATE_MIN=0.25
REPLY_RATE_CHECK_HOURS=48

# === Ramp-up ===
RAMPUP_ENABLED=true
RAMPUP_DAYS=14
RAMPUP_START_LIMIT=3

# === Live reload (fallback-опрос если Redis недоступен) ===
POOL_RELOAD_INTERVAL_SECONDS=300

# === Healthcheck и алерты в Telegram ===
HEALTH_CHECK_INTERVAL_SECONDS=300
ALERT_ACTIVE_RATIO_THRESHOLD=0.7
ALERT_REPLY_RATE_THRESHOLD=0.10
ALERT_BURN_RATE_THRESHOLD=0.05
# Бот для алертов — создай через @BotFather, токен сюда
ALERT_BOT_TOKEN=
# chat_id куда слать (твой личный или ID группы с минусом)
ALERT_CHAT_ID=

# === Dashboard / API ===
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_TOKEN=change-me-to-long-random
