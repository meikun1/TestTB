# Telegram API (https://my.telegram.org/apps)
TG_API_ID=
TG_API_HASH=
TG_PHONE=+7XXXXXXXXXX
TG_SESSION_NAME=tg_assistant_session

# Anthropic API (на первое время; потом заменим на свою модель)
ANTHROPIC_API_KEY=

# Антиспам-лимиты
MAX_MESSAGES_PER_DAY=20
MIN_DELAY_SECONDS=300
MAX_DELAY_SECONDS=2400
WORKING_HOURS_START=10
WORKING_HOURS_END=22

# Путь к БД
DB_PATH=data/tg_assistant.db
